# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Model backend: mock (default, free/offline) | gemini | bedrock
LLM_BACKEND=mock

# Required when LLM_BACKEND=gemini
GOOGLE_API_KEY=

# Required when LLM_BACKEND=bedrock (AWS, paid)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL=bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0
