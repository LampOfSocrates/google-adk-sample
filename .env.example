# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Model backend: mock (free/offline) | gemini | openai | deepseek | bedrock
# openai/deepseek/bedrock need: pip install "google-adk[extensions]"
LLM_BACKEND=mock

# Required when LLM_BACKEND=gemini
GOOGLE_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite

# Required when LLM_BACKEND=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=openai/gpt-4o-mini

# Required when LLM_BACKEND=deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek/deepseek-chat

# Required when LLM_BACKEND=bedrock (AWS, paid)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL=bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0
